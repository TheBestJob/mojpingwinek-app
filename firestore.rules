rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function mine(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid} {
      allow read, create, update, delete: if mine(uid);
      match /events/{id} {
        allow read, delete: if mine(uid);
        allow create, update: if mine(uid)
          && request.resource.data.keys().hasOnly(['title', 'date', 'time', 'notes', 'createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 150
          && request.resource.data.date is string && request.resource.data.date.size() == 10
          && request.resource.data.time is string && request.resource.data.time.size() <= 5
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 1500;
      }
      match /notes/{id} {
        allow read, delete: if mine(uid);
        allow create, update: if mine(uid)
          && request.resource.data.keys().hasOnly(['title', 'body', 'createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 150
          && request.resource.data.body is string && request.resource.data.body.size() <= 5000;
      }
      match /documents/{id} {
        allow read, delete: if mine(uid);
        allow create: if mine(uid)
          && request.resource.data.keys().hasOnly(['name', 'storagePath', 'size', 'createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 180
          && request.resource.data.storagePath is string
          && request.resource.data.storagePath.matches('users/' + uid + '/documents/[a-zA-Z0-9_-]+')
          && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 10485760;
      }
    }
  }
}
